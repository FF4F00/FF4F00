set -o errexit
set -o nounset
set -o pipefail

# Base workspace
WRK_="$HOME/.wrk_"

# ┌─────────────┐
# │ usage       │
# └─────────────┘
foundry_usage() {
  cat <<'EOF'
usage:
  foundry -s                             # self (no args)
  foundry -h | --help                    # help
EOF
}

# ┌─────────────┐
# │ self        │
# └─────────────┘
foundry_self() {
  # strict inside as well
  set -e

  # ignore any passed arguments
  if [ "$#" -ne 0 ]; then
    echo "ℹ️  ignoring arguments to 'self' (takes no parameters)"
  fi

  local foundry_source_path="${WRK_}/foundry/foundry"
  local foundry_dest_dir="/usr/local/bin"
  local foundry_dest="${foundry_dest_dir}/foundry"

  # 0) pick an editor ($EDITOR preferred; fallback to vi)
  local editor="${EDITOR:-}"
  if [ -n "$editor" ] && command -v "$editor" >/dev/null 2>&1; then
    :
  elif command -v vi >/dev/null 2>&1; then
    editor="vi"
  else
    echo "❌ no suitable editor found (set \$EDITOR or install 'vi')" >&2
    return 1
  fi

  # 1) edit the version-controlled source
  if [ ! -f "$foundry_source_path" ]; then
    echo "❌ not found: $foundry_source_path" >&2
    return 1
  fi
  "$editor" "$foundry_source_path" || {
    echo "❌ editor failed; aborting install" >&2; return 1;
  }

  # 2) ensure destination directory exists (sudo on first-time setups)
  if [ ! -d "$foundry_dest_dir" ]; then
    echo "ℹ️  creating $foundry_dest_dir (sudo)"
    sudo mkdir -p "$foundry_dest_dir"
  fi

  # 3) install/update live binary atomically with correct mode
  if sudo install -m 0755 "$foundry_source_path" "$foundry_dest"; then
    :
  else
    echo "❌ install failed. Try:" >&2
    echo "   sudo install -m 0755 \"$foundry_source_path\" \"$foundry_dest\"" >&2
    return 1
  fi

  # 4) verify executable
  if [ -x "$foundry_dest" ]; then
    echo "✅ installed: $foundry_dest"
  else
    echo "⚠️  installed but not executable; fixing (sudo)"
    sudo chmod +x "$foundry_dest" || { echo "❌ chmod failed on $foundry_dest" >&2; return 1; }
    echo "✅ fixed permissions: $foundry_dest"
  fi
}

# ┌─────────────┐
# │ dispatcher  │
# └─────────────┘
foundry() {
  case "${1:-}" in
    -s) shift || true; foundry_self "$@";;
    -h|--help|"") foundry_usage;;
    -*)
      echo "❌ unknown flag: $1" >&2
      foundry_usage; return 2
      ;;
    *)
      # For now, only -s is supported.
      echo "❌ only '-s' is supported right now." >&2
      foundry_usage; return 2
      ;;
  esac
}

# ── main ──
foundry "$@"


