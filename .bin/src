#!/usr/bin/env zsh

set -o errexit
set -o nounset
set -o pipefail

# Base workspace
WRK_="$HOME/.wrk_"

# ┌─────────────┐
# │ usage       │
# └─────────────┘
src_usage() {
  cat <<'EOF'
usage:
  src -s                             # self (no args)
  src -h | --help                    # help
EOF
}

# ┌─────────────┐
# │ self        │
# └─────────────┘
src_self() {
  # strict inside as well
  set -e

  # ignore any passed arguments
  if [ "$#" -ne 0 ]; then
    echo "ℹ️  ignoring arguments to 'self' (takes no parameters)"
  fi

  local src_source_path="${WRK_}/.src/src"
  local src_dest_dir="/usr/local/bin"
  local src_dest="${src_dest_dir}/src"

  # 0) pick an editor ($EDITOR preferred; fallback to vi)
  local editor="${EDITOR:-}"
  if [ -n "$editor" ] && command -v "$editor" >/dev/null 2>&1; then
    :
  elif command -v vi >/dev/null 2>&1; then
    editor="vi"
  else
    echo "❌ no suitable editor found (set \$EDITOR or install 'vi')" >&2
    return 1
  fi

  # 1) edit the version-controlled source
  if [ ! -f "$src_source_path" ]; then
    echo "❌ not found: $src_source_path" >&2
    return 1
  fi
  "$editor" "$src_source_path" || {
    echo "❌ editor failed; aborting install" >&2; return 1;
  }

  # 2) ensure destination directory exists (sudo on first-time setups)
  if [ ! -d "$src_dest_dir" ]; then
    echo "ℹ️  creating $src_dest_dir (sudo)"
    sudo mkdir -p "$src_dest_dir"
  fi

  # 3) install/update live binary atomically with correct mode
  if sudo install -m 0755 "$src_source_path" "$src_dest"; then
    :
  else
    echo "❌ install failed. Try:" >&2
    echo "   sudo install -m 0755 \"$src_source_path\" \"$src_dest\"" >&2
    return 1
  fi

  # 4) verify executable
  if [ -x "$src_dest" ]; then
    echo "✅ installed: $src_dest"
  else
    echo "⚠️  installed but not executable; fixing (sudo)"
    sudo chmod +x "$src_dest" || { echo "❌ chmod failed on $src_dest" >&2; return 1; }
    echo "✅ fixed permissions: $src_dest"
  fi
}

# ┌─────────────┐
# │ dispatcher  │
# └─────────────┘
src() {
  case "${1:-}" in
    -s) shift || true; src_self "$@";;
    -h|--help|"") src_usage;;
    -*)
      echo "❌ unknown flag: $1" >&2
      src_usage; return 2
      ;;
    *)
      # For now, only -s is supported.
      echo "❌ only '-s' is supported right now." >&2
      src_usage; return 2
      ;;
  esac
}

# ── main ──
src "$@"




