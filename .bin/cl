#!/usr/bin/env sh
set -e

LOG_DIR="${LOG_DIR:-$HOME/.log}"
EDITOR="${EDITOR:-nvim}"
DATE="$(date +%Y-%m-%d)"

die() {
  echo "❌ $*" >&2
  exit 1
}

normalize_repo() {
  echo "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9 ]//g' \
    | sed 's/ \+/-/g'
}

ensure_git() {
  [ -d ".git" ] || git init >/dev/null
}

ensure_gitignore() {
  [ -f ".gitignore" ] && return
  cat > .gitignore <<EOF
.DS_Store
*.swp
*~
EOF
  git add .gitignore >/dev/null
}

git_status_hint() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo
    echo "⚠️  Uncommitted changes:"
    git status --short
  fi
}

open_note() {
  FILE="$1"
  DIR="$(dirname "$FILE")"
  mkdir -p "$DIR"

  if [ ! -f "$FILE" ]; then
    TITLE="$(basename "$FILE" .md)"
    cat > "$FILE" <<EOF
# $TITLE
---
> stardate: $DATE

EOF
  fi

  exec "$EDITOR" "$FILE"
}

# -------------------------------------------------
# Bootstrap
# -------------------------------------------------

mkdir -p "$LOG_DIR"
cd "$LOG_DIR"

ensure_git
ensure_gitignore

# -------------------------------------------------
# Parse command
# -------------------------------------------------

CMD="$1"
shift || true

# -------------------------------------------------
# cl init
# -------------------------------------------------

if [ "$CMD" = "init" ]; then
  PLATFORM=""
  case "$1" in
    -gh|-glab)
      PLATFORM="$1"
      shift
      ;;
    *)
      die "Usage: cl init -gh|-glab <repo name>"
      ;;
  esac

  [ $# -gt 0 ] || die "Repository name required"

  DISPLAY_NAME="$*"
  REPO_NAME="$(normalize_repo "$DISPLAY_NAME")"
  [ -n "$REPO_NAME" ] || die "Invalid repository name"

  if git remote | grep -q origin; then
    die "Remote already configured"
  fi

  case "$PLATFORM" in
    -gh)
      command -v gh >/dev/null || die "gh CLI not installed"
      gh repo create "$REPO_NAME" --private --source=. --remote=origin --push
      ;;
    -glab)
      command -v glab >/dev/null || die "glab CLI not installed"
      glab repo create "$REPO_NAME" --private --source=. --remote=origin --push
      ;;
  esac

  echo "✅ Repository created and pushed"
  git_status_hint
  exit 0
fi

# -------------------------------------------------
# Flags (whitespace-safe)
# -------------------------------------------------

ARGS="$*"

case "$CMD" in
  -ld)
    TARGET="${ARGS:-.}"
    find "$TARGET" -type d | sort
    exit 0
    ;;
  -ln)
    TARGET="${ARGS:-.}"
    find "$TARGET" -type f -name '*.md' | sort
    exit 0
    ;;
  -l)
    TARGET="${ARGS:-.}"
    find "$TARGET" \( -type d -o -name '*.md' \) | sort
    exit 0
    ;;
  -d)
    [ -n "$ARGS" ] || die "Usage: cl -d <dir>"
    mkdir -p "$ARGS"
    echo "✅ Directory created: $ARGS"
    git_status_hint
    exit 0
    ;;
  -n)
    [ -n "$ARGS" ] || die "Usage: cl -n <note>"
    open_note "$ARGS.md"
    ;;
  -p)
    [ -n "$ARGS" ] || die "Usage: cl -p \"message\""
    git add .
    git commit -m "$ARGS"
    git push
    git_status_hint
    exit 0
    ;;
esac

# -------------------------------------------------
# Default: open or create note
# -------------------------------------------------

[ -n "$CMD" ] || die "Usage: cl <note path>"
open_note "$CMD.md"
