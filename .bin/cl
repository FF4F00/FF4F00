#!/usr/bin/env sh
set -e

LOG_DIR="$HOME/.log"
EDITOR="${EDITOR:-nvim}"
DATE="$(date +%Y-%m-%d)"

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Prompt for note name
printf "Captain’s Log — enter note name: "
read -r NAME

if [ -z "$NAME" ]; then
  echo "❌ Note name cannot be empty."
  exit 1
fi

# Sanitize filename (spaces -> underscores)
FILENAME="$(printf "%s" "$NAME" | tr ' ' '_' ).md"
FILEPATH="$LOG_DIR/$FILENAME"

# Prevent overwrite
if [ -f "$FILEPATH" ]; then
  echo "❌ Log already exists: $FILEPATH"
  exit 1
fi

# Create note
cat > "$FILEPATH" <<EOF
# $NAME
---
> stardate: $DATE

EOF

# Open in editor
exec "$EDITOR" "$FILEPATH"
