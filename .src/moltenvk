#!/bin/sh

# ✅ Verified 07/09/2025
# ⚠️ Requires: Signature
# ⚠️ Dependencies: CMake, Xcode, Python3
# Target: Apple Silicon
# MoltenVK 1.3.0

DIR="/tmp"
MVK_VERSION="v1.3.0"

# Clean up any existing installations
sudo rm -rf /tmp/MoltenVK-1.3.0

if [ ! -f /usr/local/lib/libMoltenVK.dylib ]; then

    # ⚠️ Dependencies
    
    [ ! -f /usr/local/bin/cmake ] && ./CMAKE  # ✅

    # Download
    curl -Lo "$DIR/moltenvk-${MVK_VERSION}.tar.gz" "https://github.com/KhronosGroup/MoltenVK/archive/refs/tags/${MVK_VERSION}.tar.gz"

    # Extract
    tar -xzvf "$DIR/moltenvk-${MVK_VERSION}.tar.gz" -C "$DIR" && rm -f "$DIR/moltenvk-${MVK_VERSION}.tar.gz"

    # Build
    (cd "$DIR/MoltenVK-1.3.0" && \
     # Fetch dependencies
     ./fetchDependencies --macos && \
     # Build using make
     make macos && \
     # Create installation directories
     sudo mkdir -p /usr/local/lib && \
     sudo mkdir -p /usr/local/include/MoltenVK && \
     sudo mkdir -p /usr/local/share/vulkan/icd.d)

    # Install
    (cd "$DIR/MoltenVK-1.3.0" && \
     # Copy libraries
     sudo cp Package/Latest/MoltenVK/dynamic/dylib/macOS/libMoltenVK.dylib /usr/local/lib/ && \
     sudo cp Package/Latest/MoltenVK/static/MoltenVK.xcframework/macos-arm64_x86_64/libMoltenVK.a /usr/local/lib/ && \
     # Copy headers
     sudo cp -r MoltenVK/MoltenVK/API/* /usr/local/include/MoltenVK/ && \
     # Copy ICD manifest
     sudo cp MoltenVK/icd/MoltenVK_icd.json /usr/local/share/vulkan/icd.d/ && \
     # Update library permissions
     sudo chmod 755 /usr/local/lib/libMoltenVK.dylib && \
     sudo chmod 644 /usr/local/lib/libMoltenVK.a)

    # Set up environment (optional - for current session)
    export VK_ICD_FILENAMES=/usr/local/share/vulkan/icd.d/MoltenVK_icd.json
    export VK_LAYER_PATH=/usr/local/share/vulkan/explicit_layer.d

    # Clean up
    sudo rm -rf /tmp/MoltenVK-1.3.0

fi