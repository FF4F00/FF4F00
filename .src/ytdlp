#!/bin/sh

# ✅ Verified 07/08/2025
# Target: Apple Silicon
# yt-dlp v2025.06.30

if [ ! -f "$HOME/Library/Python/3.9/bin/yt-dlp" ]; then

    # ⚠️ Dependencies:
    #  python3
    #  pip3        

    # Install via pip3
    pip3 install --user -U yt-dlp

    # Add Python 3.9 bin to PATH if not already present
    if ! echo "$PATH" | grep -q "$HOME/Library/Python/3.9/bin"; then
        echo 'export PATH="$HOME/Library/Python/3.9/bin:$PATH"' >> ~/.zshrc
        echo "Added yt-dlp bin path to ~/.zshrc"
    fi
fi