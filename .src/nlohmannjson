#!/bin/sh
set -e

# ✅ Verified 07/2025
# Target: macOS (Apple Silicon or Intel)
# Library: nlohmann/json v3.12.0 (header-only)

DIR="/tmp"
VERSION="3.12.0"
DEST="/usr/local/include/nlohmann"

if [ ! -f "$DEST/json.hpp" ]; then

    # Download
    curl -Lo "$DIR/json-$VERSION.tar.gz" "https://github.com/nlohmann/json/archive/refs/tags/v$VERSION.tar.gz"

    # Extract
    tar -xzf "$DIR/json-$VERSION.tar.gz" -C "$DIR"
    rm -f "$DIR/json-$VERSION.tar.gz"

    # Install header
    sudo mkdir -p "$DEST"
    sudo cp "$DIR/json-$VERSION/single_include/nlohmann/json.hpp" "$DEST/"

    # Cleanup extracted folder
    rm -rf "$DIR/json-$VERSION"
fi

