#!/bin/sh

# ✅ Verified 07/09/2025
# ⚠️ Requires: Signature
# ⚠️ Dependencies: Meson, Ninja, Vulkan SDK, MoltenVK, Python3, jinja2, glad2, Git, FastFloat
# Target: Apple Silicon
# libplacebo v7.351.0

DIR="/tmp"
VERSION="7.351.0"

sudo rm -rf "$DIR/libplacebo-${VERSION}"

if [ ! -f /usr/local/lib/libplacebo.dylib ]; then

    # ⚠️ Dependencies
    
    [ ! -f /usr/local/bin/meson ]                       && ./MESON       # ✅
    [ ! -f /usr/local/bin/ninja ]                       && ./NINJA       # ✅
    [ ! -f /usr/local/lib/libvulkan.dylib ]             && ./VULKANSDK   # ✅
    [ ! -f /usr/local/lib/libMoltenVK.dylib ]           && ./MOLTENVK    # ✅
    [ ! -f /usr/local/bin/glslc ]                       && ./SHADERC     # ✅
    [ ! -f /usr/local/include/fast_float/fast_float.h ] && ./FASTFLOAT # ✅

    # Install Python dependencies
    pip3 install jinja2 glad2

    # Download
    curl -Lo "$DIR/libplacebo-${VERSION}.tar.gz" "https://github.com/haasn/libplacebo/archive/refs/tags/v${VERSION}.tar.gz"

    # Extract
    tar -xzvf "$DIR/libplacebo-${VERSION}.tar.gz" -C "$DIR" && rm -f "$DIR/libplacebo-${VERSION}.tar.gz"

    # Initialize Git repository and fetch submodules
    (cd "$DIR/libplacebo-${VERSION}" && \
     git init && \
     git remote add origin https://github.com/haasn/libplacebo.git && \
     git fetch origin v${VERSION} && \
     git checkout FETCH_HEAD && \
     git submodule update --init --recursive)

    # Clean any existing build and setup fresh build
    (cd "$DIR/libplacebo-${VERSION}" && \
     rm -rf build && \
     meson --wipe 2>/dev/null || true && \
     meson setup build \
       --prefix=/usr/local \
       -Dopengl=disabled \
       -Dvulkan=enabled \
       -Dtests=false \
       -Dshaderc=enabled && \
     ninja -C build && \
     sudo ninja -C build install)
fi