#!/bin/sh

# Get the directory containing this script
DIR=$(dirname "$0")

# Source common functions and variables
source "$DIR/PKGCONFIG"

VERSION="0.1.3"

# Check if already installed
if [ -f "/usr/local/lib/libsoxr.dylib" ]; then
    echo "soxr-${VERSION} already installed"
    exit 0
fi

# Download
echo "Downloading soxr-${VERSION}..."
wget -O "$DIR/soxr-${VERSION}.tar.gz" "https://sourceforge.net/projects/soxr/files/soxr-${VERSION}-Source.tar.gz"

# Extract
echo "Extracting soxr-${VERSION}..."
cd "$DIR" && tar xzf "soxr-${VERSION}.tar.gz"

# Build and install
echo "Building soxr-${VERSION}..."
cd "$DIR/soxr-${VERSION}-Source" && \
cmake . -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON && \
make && sudo make install

# Cleanup
cd "$DIR" && rm -rf "soxr-${VERSION}.tar.gz" "soxr-${VERSION}-Source"