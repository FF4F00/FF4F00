#!/bin/sh

# Get the directory containing this script
DIR=$(dirname "$0")

# Source common functions and variables
source "$DIR/PKGCONFIG"
source "$DIR/NETTLE"

VERSION="3.8.4"

# Check if already installed
if [ -f "/usr/local/lib/libgnutls.dylib" ]; then
    echo "gnutls-${VERSION} already installed"
    exit 0
fi

# Download
echo "Downloading gnutls-${VERSION}..."
wget -O "$DIR/gnutls-${VERSION}.tar.xz" "https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-${VERSION}.tar.xz"

# Extract
echo "Extracting gnutls-${VERSION}..."
cd "$DIR" && tar xf "gnutls-${VERSION}.tar.xz"

# Build and install
echo "Building gnutls-${VERSION}..."
cd "$DIR/gnutls-${VERSION}" && \
./configure --prefix=/usr/local \
    --with-included-libtasn1 \
    --with-included-unistring \
    --without-p11-kit \
    --disable-static && \
make && sudo make install

# Cleanup
cd "$DIR" && rm -rf "gnutls-${VERSION}.tar.xz" "gnutls-${VERSION}"