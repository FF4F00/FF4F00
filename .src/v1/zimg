#!/bin/sh

# Get the directory containing this script
DIR=$(dirname "$0")

# Source common functions and variables
source "$DIR/PKGCONFIG"

VERSION="3.0.5"

# Check if already installed
if [ -f "/usr/local/lib/libzimg.dylib" ]; then
    echo "zimg-${VERSION} already installed"
    exit 0
fi

# Download
echo "Downloading zimg-${VERSION}..."
wget -O "$DIR/zimg-${VERSION}.tar.gz" "https://github.com/sekrit-twc/zimg/archive/release-${VERSION}.tar.gz"

# Extract
echo "Extracting zimg-${VERSION}..."
cd "$DIR" && tar xzf "zimg-${VERSION}.tar.gz"

# Build and install
echo "Building zimg-${VERSION}..."
cd "$DIR/zimg-release-${VERSION}" && \
./autogen.sh && \
./configure --prefix=/usr/local --enable-shared --disable-static && \
make && sudo make install

# Cleanup
cd "$DIR" && rm -rf "zimg-${VERSION}.tar.gz" "zimg-release-${VERSION}"