#!/bin/sh

# ✅ Verified 07/2025
# Target: macOS Apple Silicon
# App: rmpc v0.9.0

DIR="/tmp"
VERSION="0.9.0"

if [ ! -f /usr/local/bin/rmpc ]; then

  # Download
  curl -Lo "$DIR/rmpc-v${VERSION}-aarch64-apple-darwin.tar.gz" \
    "https://github.com/mierak/rmpc/releases/download/v0.9.0/rmpc-v0.9.0-aarch64-apple-darwin.tar.gz"

  # Extract
  tar -xzf "$DIR/rmpc-v${VERSION}-aarch64-apple-darwin.tar.gz" -C "$DIR"
  rm -f "$DIR/rmpc-v${VERSION}-aarch64-apple-darwin.tar.gz"

  # Install
  sudo install -m 755 "$DIR/rmpc" /usr/local/bin/rmpc
  [ -f "$DIR/completions/rmpc.zsh" ] && sudo install -m 644 "$DIR/completions/rmpc.zsh" /usr/local/share/zsh/site-functions/_rmpc

fi
