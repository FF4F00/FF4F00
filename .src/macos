
##############################################################################
# macOS Provisioning Script
# Description: Secure and streamline a fresh macOS environment
# Features: Wi-Fi config, security hardening, UX tweaks, developer tools, etc.
# Author: [Yusef Nso / FF4F00]
###############################################################################

set -e

xcode-select --install
softwareupdate --install-rosetta --agree-to-license
source $HOME/.•/src/macports

### NETWORK CONFIGURATION #####################################################

# Connect to Wi-Fi (replace SSID and password if needed)
networksetup -setairportnetwork en0 "SFO" "SFOn37w122"

### SECURITY ##################################################################

# Enable FileVault for full-disk encryption
sudo fdesetup enable

# Enable firewall and stealth mode (drop pings, hide open ports)
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate

# Set timezone
sudo systemsetup -settimezone "America/Los_Angeles"

### SYSTEM APPEARANCE #########################################################

# Set appearance mode to match system (can be: Light, Dark, System)
defaults write NSGlobalDomain AppleInterfaceStyle -string "System"

# Enable Siri (Apple Intelligence)
sudo defaults write com.apple.assistant.support 'Assistant Enabled' -bool true

### TRACKPAD & INPUT ##########################################################

# Disable natural scroll direction
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false

# Enable tap-to-click
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
sudo defaults write com.apple.mouse.tapBehavior -int 1

# Maximize trackpad speed
defaults write -g com.apple.trackpad.scaling -float 3.0

# Apply input changes
killall SystemUIServer

### MENU BAR CUSTOMIZATION ####################################################

# Add menu bar items (Weather, Wi-Fi, Bluetooth, etc.)
MENU_ITEMS=(
  "/System/Library/CoreServices/Menu Extras/Weather.menu"
  "/System/Library/CoreServices/Menu Extras/AirPort.menu"
  "/System/Library/CoreServices/Menu Extras/Bluetooth.menu"
  "/System/Library/CoreServices/Menu Extras/DoNotDisturb.menu"
  "/System/Library/CoreServices/Menu Extras/StageManager.menu"
  "/System/Library/CoreServices/Menu Extras/Volume.menu"
  "/System/Library/CoreServices/Menu Extras/NowPlaying.menu"
  "/System/Library/CoreServices/Menu Extras/Battery.menu"
  "/System/Library/CoreServices/Menu Extras/MusicRecognition.menu"
  "/System/Library/CoreServices/Menu Extras/KeyboardBrightness.menu"
  "/System/Library/CoreServices/Menu Extras/Clock.menu"
  "/System/Library/CoreServices/Menu Extras/Siri.menu"
  "/System/Library/CoreServices/Menu Extras/TimeMachine.menu"
)

for item in "${MENU_ITEMS[@]}"; do
  defaults write com.apple.systemuiserver menuExtras -array-add "$item"
done

# Optional: Replace with minimal menu bar icons
defaults write com.apple.systemuiserver menuExtras -array \
  "/System/Library/CoreServices/Menu Extras/AirPort.menu" \
  "/System/Library/CoreServices/Menu Extras/Bluetooth.menu" \
  "/System/Library/CoreServices/Menu Extras/Battery.menu" \
  "/System/Library/CoreServices/Menu Extras/Clock.menu"

killall SystemUIServer

### DOCK CONFIGURATION ########################################################

defaults write com.apple.dock orientation -string "bottom"
defaults write com.apple.dock minimize-to-application -bool true
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.stage-manager show-mac-apps -bool false
defaults write NSGlobalDomain AppleActionOnDoubleClick -string "Minimize"

# Disable Hot Corners (all four)
defaults write com.apple.dock wvous-tl-corner -int 0
defaults write com.apple.dock wvous-tr-corner -int 0
defaults write com.apple.dock wvous-bl-corner -int 0
defaults write com.apple.dock wvous-br-corner -int 0

# Disable Launchpad and Mission Control hotkeys
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 64 '{enabled = 0;}'
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 65 '{enabled = 0;}'

# Apply changes
killall Dock
killall Finder

### DISPLAY CONFIGURATION #####################################################

# Set system display profile to sRGB
defaults write /Library/Preferences/com.apple.windowserver DisplayProfile -string "sRGB IEC61966-2.1"

### DEV TOOLS #################################################################

# Install Command Line Tools
xcode-select --install || true

# Install Rosetta (for Apple Silicon)
/usr/sbin/softwareupdate --install-rosetta --agree-to-license

### SOFTWARE UPDATES ##########################################################

sudo softwareupdate --schedule on
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true
sudo defaults write /Library/Preferences/com.apple.commerce AutoUpdate -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool true

### DISABLE TYPING "ENHANCEMENTS" #############################################

defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write com.apple.Terminal NSAutomaticTextCompletionEnabled -bool false

### INSTALL HOMEBREW ##########################################################

if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "Homebrew already installed."
fi

### FF4F00 REPO SETUP #########################################################

if [ -d "$HOME/.ff4f00" ]; then
  echo "Updating FF4F00 repository..."
  cd "$HOME/.ff4f00"
  git remote update
  if git status -uno | grep -q 'Your branch is behind'; then
    git pull
  else
    echo "FF4F00 is up to date."
  fi
else
  echo "Cloning FF4F00..."
  git clone https://github.com/FF4F00/monolith.git /tmp/monolith
  mv /tmp/monolith/.ff4f00 "$HOME/"
fi

### REBOOT PROMPT #############################################################

echo "Would you like to reboot now to apply all changes? (y/n)"
read -r answer
if [ "$answer" = "y" ]; then
  osascript -e 'tell app "System Events" to restart'
fi