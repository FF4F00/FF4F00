VERSION="25.3"
ARCH="osx-aarch_64"  # Use "osx-x86_64" if you're on Intel
PROTOC_ZIP="protoc-${VERSION}-${ARCH}.zip"
URL="https://github.com/protocolbuffers/protobuf/releases/download/v${VERSION}/${PROTOC_ZIP}"
TMP="/tmp"

curl -L -o "$TMP/$PROTOC_ZIP" "$URL"
unzip -o "$TMP/$PROTOC_ZIP" -d "$TMP/protoc"
sudo cp "$TMP/protoc/bin/protoc" /usr/local/bin/
sudo chmod +x /usr/local/bin/protoc

