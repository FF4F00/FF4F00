#!/bin/sh

# ✅ Verified 07/2025
# Target: macOS (Apple Silicon or Intel)
# Builds: cava 0.10.4

DIR="/tmp"
VERSION="0.10.4"

if [ ! -f /usr/local/bin/cava ]; then

    # ⚠️ Dependencies

    [ ! -f /usr/local/lib/libfftw3.dylib ]     && ./FFTW        # ✅
    [ ! -f /usr/local/include/iniparser.h ]    && ./INIPARSER   # ✅
    [ ! -f /usr/local/bin/autoconf ]           && ./AUTOCONF    # ✅
    [ ! -f /usr/local/bin/automake ]           && ./AUTOMAKE    # ✅
    [ ! -f /usr/local/bin/libtool ]            && ./LIBTOOL     # ✅
    [ ! -f /usr/local/bin/pkg-config ]         && ./PKGCONF     # ✅ 

    # Make sure pkg.m4 is available for autoconf macros
    mkdir -p /usr/local/share/aclocal
    curl -sSL -o /usr/local/share/aclocal/pkg.m4 https://raw.githubusercontent.com/pkg-config/pkg-config/master/pkg.m4

    # Download
    curl -L -o "$DIR/cava-$VERSION.tar.gz" "https://github.com/karlstav/cava/archive/refs/tags/$VERSION.tar.gz"

    # Extract
    tar -xzf "$DIR/cava-$VERSION.tar.gz" -C "$DIR" && rm -f "$DIR/cava-$VERSION.tar.gz"

    # Build and install
    cd "$DIR/cava-$VERSION"
    export ACLOCAL_PATH="/usr/local/share/aclocal"
    ./autogen.sh
    ./configure \
      --prefix=/usr/local \
      --enable-ncurses \
      --disable-alsa \
      --disable-jack \
      --disable-pulse \
      --disable-portaudio \
      --disable-pipewire \
      --disable-sndio

    make -j$(sysctl -n hw.ncpu)
    sudo make install
fi
