#!/bin/sh
set -e

# ✅ Verified 2025-07-08
# SketchyBar v2.23.0
# Target: Apple Silicon (macOS)

sudo rm -rf /tmp/SketchyBar
sudo rm -rf /usr/local/bin/SketchyBar


if [ ! -f /usr/local/bin/sketchybar ]; then


  git clone --branch v2.23.0 https://github.com/FelixKratz/SketchyBar.git /tmp/SketchyBar
  cd /tmp/SketchyBar
  make
  sudo cp bin/sketchybar /usr/local/bin/
  rm -rf /tmp/SketchyBar

  # --- Create LaunchAgent ---
  mkdir -p ~/Library/LaunchAgents
  cat << 'EOF' > ~/Library/LaunchAgents/com.sketchybar.plist
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sketchybar</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/sketchybar</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
EOF

  # --- Load and start LaunchAgent ---
  launchctl load ~/Library/LaunchAgents/com.sketchybar.plist
  launchctl start com.sketchybar

  echo "✅ SketchyBar installed and started as a background service."

fi


