#!/bin/sh

# Get the directory containing this script
DIR=$(dirname "$0")

# Source common functions and variables
source "$DIR/PKGCONFIG"

VERSION="2.17"

# Check if already installed
if [ -f "/usr/local/lib/liblcms2.dylib" ]; then
    echo "lcms2-${VERSION} already installed"
    exit 0
fi

# Download
echo "Downloading lcms2-${VERSION}..."
wget -O "$DIR/lcms2-${VERSION}.tar.gz" "https://github.com/mm2/Little-CMS/releases/download/lcms${VERSION}/lcms2-${VERSION}.tar.gz"

# Extract
echo "Extracting lcms2-${VERSION}..."
cd "$DIR" && tar xzf "lcms2-${VERSION}.tar.gz"

# Build and install
echo "Building lcms2-${VERSION}..."
cd "$DIR/lcms2-${VERSION}" && \
./configure --prefix=/usr/local --disable-static && \
make && sudo make install

# Cleanup
cd "$DIR" && rm -rf "lcms2-${VERSION}.tar.gz" "lcms2-${VERSION}"