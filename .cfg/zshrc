# ----- Prompt (Starship if present; else compact git prompt) ------------------
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  autoload -Uz colors && colors
  git_branch_prompt() {
    local br
    br=$(command git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
    echo " %{$fg[cyan]%}(${br})%{$reset_color%}"
  }
  PROMPT='%{$fg[green]%}%n%{$reset_color%}@%{$fg[yellow]%}%m%{$reset_color%}:%{$fg[blue]%}%~%{$reset_color%}$(git_branch_prompt)
$ '
fi

