# ----- Git: clean, predictable porcelain -------------------------------------
# Commit staged-if-any; never fail on "nothing to commit"
gcif() {
  git add -A
  if ! git diff --cached --quiet; then
    git commit -m "${1:-+/=}"
  fi
}

# Push current branch with upstream if needed
up() {
  local cur; cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1
  if git rev-parse --abbrev-ref "@{u}" >/dev/null 2>&1; then
    git push
  else
    git push --set-upstream origin "$cur"
  fi
}

