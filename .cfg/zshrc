# ----- Editor/open helpers ----------------------------------------------------
edit() {                      # open with nvim→vim→vi fallback
  if command -v nvim >/dev/null 2>&1; then nvim "$@"
  elif command -v vim  >/dev/null 2>&1; then vim  "$@"
  else vi "$@"; fi
}

